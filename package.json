  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:portfolio": "playwright test tests/auth/login.spec.ts tests/inventory/inventory.spec.ts tests/checkout/checkout.spec.ts --project=chromium",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --grep @a11y",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:allure": "playwright test --reporter=line,allure-playwright",
    "install-browsers": "playwright install",
    "report:agents": "node src/utils/build-agent-scorecard.mjs",
    "pr:dry-run": "node src/utils/review-and-prepare-pr.mjs",
    "review:pr": "node src/utils/review-pull-request.mjs",
    "triage:ci-failure": "node src/utils/triage-playwright-failure.mjs",
    "impact:tests": "node src/utils/analyze-test-impact.mjs",
    "risk:release": "node src/utils/analyze-release-risk.mjs"
  },
  "keywords": [],
  "author": "",
